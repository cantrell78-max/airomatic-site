---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="圍棋易經 / Go I Ching"
  description="A contemplative browser game of Go fused with the I Ching. Play offline in the browser — Traditional Chinese and English."
  ogImage="/images/blog/go-i-ching-og.jpg"
  ogImageAlt="Go I Ching — Elder Yi at the board on airomatic.ai"
  noTranslate={true}
>
  <section class="gic-page">
    <iframe
      class="gic-frame"
      src="/go-i-ching/app.html"
      title="Go I Ching — playable Weiqi and I Ching"
      allow="fullscreen"
      allowfullscreen
    ></iframe>
  </section>
</BaseLayout>

<style>
  .gic-page {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - var(--header-h, 4rem));
    margin: 0;
    padding: 0;
  }

  .gic-frame {
    flex: 1;
    width: 100%;
    min-height: calc(100vh - var(--header-h, 4rem));
    border: 0;
    display: block;
    background: #e8dcc8;
  }
</style>
