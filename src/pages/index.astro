---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { site } from "../config/site";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Home"
  description="Airomatic builds practical AI tools in public — live on YouTube with Grok Build. AI That Smells Success."
  ogImageAlt={`${site.name} — ${site.ogTagline}`}
>
  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow mono">AI startup · Built in public</p>
      <h1>Intelligence, engineered live.</h1>
      <p class="lead">
        {site.name} builds practical AI tools and ships them in the open — including this site, coded live on YouTube with Grok Build.
      </p>
      <div class="hero__actions">
        {
          site.youtubeUrl ? (
            <a href="/live/" class="btn btn--live">Watch live</a>
          ) : (
            <a href="/live/" class="btn">Live sessions</a>
          )
        }
        <a href="/blog/" class="btn btn--ghost">Read the build log</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Focus</p>
      <h2>What we're building</h2>
      <div class="grid-services">
        <article class="card">
          <h3>AI tooling</h3>
          <p>Pragmatic software that puts large language models to work on real problems — not demos for their own sake.</p>
        </article>
        <article class="card">
          <h3>Live development</h3>
          <p>Grok Build coding sessions streamed on YouTube. Watch architecture decisions, implementation, and deploys as they happen.</p>
        </article>
        <article class="card">
          <h3>Open process</h3>
          <p>Blog posts, session recaps, and embedded videos documenting what we ship and how we got there.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow">Archive</p>
      <h2>Agentic AI Startup News</h2>
      <p class="lead" style="max-width: 40rem">
        A living archive of AI funding announcements generated by agents watching the real feed too closely. Patterns detected. Deals riffed. Portraits generated.
      </p>
      <p style="margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 1rem">
        <a href="/startups/" class="btn btn--ghost">Browse the archive →</a>
        <a href="/blog/agentic-ai-startup-news-live/" class="btn btn--ghost">Read the build log</a>
        <a href="/live/" class="btn btn--live">Watch live</a>
      </p>
    </div>
  </section>

  <section class="section section--tight featured-project">
    <div class="container">
      <p class="eyebrow">Featured project</p>
      <h2>Gate Crash</h2>
      <p class="lead" style="max-width: 40rem">
        Steer a crane barge in the Golden Gate strait, swing a wrecking ball through International Orange steel, and send Teslas into the bay. Clock starts on first hit. Play free.
      </p>
      <div class="grid-services" style="margin-top: 1.5rem">
        <article class="card">
          <h3>The ball is the weapon</h3>
          <p>Drive the barge, yaw the boom, pump the pendulum. Deck slabs, tower legs, and braces are separate objects — they crumple, burn, and drop.</p>
        </article>
        <article class="card">
          <h3>Teslas count extra</h3>
          <p>Traffic keeps crossing whatever roadway is left. Hit them for combo points. Gaps dump them into the tide on their own.</p>
        </article>
        <article class="card">
          <h3>Play in the browser</h3>
          <p>
            No install. <a href="/gate-crash/">/gate-crash/</a>. Build notes:
            <a href="/blog/gate-crash/">read the post →</a>
          </p>
        </article>
      </div>
      <p style="margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: 1rem">
        <a href="/gate-crash/" class="btn btn--live">Play the game</a>
        <a href="/blog/gate-crash/" class="btn btn--ghost">Read the post</a>
      </p>
    </div>
  </section>

  <section class="section section--tight featured-project">
    <div class="container">
      <p class="eyebrow">Also shipping</p>
      <h2>Fairies Wear Boots</h2>
      <p class="lead" style="max-width: 40rem">
        A 2D side-scrolling stomp-platformer: tiny fairy, oversized steel-toe combat boots, a looping late-night English street that melts into a purple-black trip. Original doom riff. Play free.
      </p>
      <div class="grid-services" style="margin-top: 1.5rem">
        <article class="card">
          <h3>The boots are the weapon</h3>
          <p>Jump, stomp-kick, screen-shake. Mash kick in the air for a short dance combo. Score the cobbles.</p>
        </article>
        <article class="card">
          <h3>Street, then the trip</h3>
          <p>Sodium lamps and rusted fences, then mushrooms, warped windows, and a dancing dwarf. Orbs invert gravity, stretch the level, or spawn extra fairies.</p>
        </article>
        <article class="card">
          <h3>Play in the browser</h3>
          <p>
            No install. <a href="/fairies-wear-boots/">/fairies-wear-boots/</a>. Build notes:
            <a href="/blog/fairies-wear-boots/">read the post →</a>
          </p>
        </article>
      </div>
      <p style="margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: 1rem">
        <a href="/fairies-wear-boots/" class="btn btn--live">Play the game</a>
        <a href="/blog/fairies-wear-boots/" class="btn btn--ghost">Read the post</a>
      </p>
    </div>
  </section>

  <section class="section section--tight featured-project">
    <div class="container">
      <p class="eyebrow">Also shipping</p>
      <h2>Strive Hard</h2>
      <p class="lead" style="max-width: 40rem">
        Leisure Suit Larry for SF tech founders — through <strong>Chapter 3: Agentic</strong> (Cognition/Devin fleets, coups, Shenzhen containment with Chinese + Translate). Also The Round, Mercury, Dylan, Palantir, FlareUp. Play free.
      </p>
      <div class="grid-services" style="margin-top: 1.5rem">
        <article class="card">
          <h3>Pick your founder</h3>
          <p>Tech bro, CMO, CS major, or math genius. DMs from Thiel, Wei in Shenzhen, your Devin fleet, and occasionally Mom.</p>
        </article>
        <article class="card">
          <h3>iHype phone HUD</h3>
          <p>X, Map (Cognition → crisis → Shenzhen), Texts (including 中文 debt collectors), <strong>FlareUp</strong>, Selfie. Google Translate on Shenzhen scenes.</p>
        </article>
        <article class="card">
          <h3>Play in the browser</h3>
          <p>
            No install. <a href="/strive-hard/">/strive-hard/</a>. Latest notes:
            <a href="/blog/strive-hard-agentic/">Agentic chapter →</a>
          </p>
        </article>
      </div>
      <p style="margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: 1rem">
        <a href="/strive-hard/" class="btn btn--live">Play the game</a>
        <a href="/blog/strive-hard-agentic/" class="btn btn--ghost">Latest update</a>
        <a href="/blog/strive-hard-live/" class="btn btn--ghost">Launch post</a>
      </p>
    </div>
  </section>

  <section class="section section--tight featured-project">
    <div class="container">
      <p class="eyebrow">Also shipping</p>
      <h2>老鼠赛跑 / Rat Race</h2>
      <p class="lead" style="max-width: 40rem">
        Wet-street cyberpunk overhead: race other rats to an X that dispenses a finite pile of pellets, get fatter and slower as you eat, hide from a cop cat. Simplified Chinese default, English toggle. Play free.
      </p>
      <div class="grid-services" style="margin-top: 1.5rem">
        <article class="card">
          <h3>The X is the clock</h3>
          <p>Pellets in the kiosk run out in public. Camp the button and Sgt. Meowz comes. Spill your stash and the other rats will steal it.</p>
        </article>
        <article class="card">
          <h3>Fat is physics</h3>
          <p>Eating scores and slows you. Skinny rats fit the alleys. Stuffed rats do not. Hide on the far side of dumpsters, TVs, and fridges.</p>
        </article>
        <article class="card">
          <h3>Play in the browser</h3>
          <p>
            No install. <a href="/rat-race/">/rat-race/</a>. Build notes:
            <a href="/blog/rat-race/">read the post →</a>
          </p>
        </article>
      </div>
      <p style="margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: 1rem">
        <a href="/rat-race/" class="btn btn--live">Play the game</a>
        <a href="/blog/rat-race/" class="btn btn--ghost">Read the post</a>
      </p>
    </div>
  </section>

  <section class="section section--tight featured-project">
    <div class="container">
      <p class="eyebrow">Also shipping</p>
      <h2>Cybertruck Assembly Line</h2>
      <p class="lead" style="max-width: 40rem">
        A three-bay browser puzzle: color-matched Cybertruck chassis, falling parts you rotate and snap into place, progressive training guides, and a factory chiptune. Built with Grok Build — play free on this site.
      </p>
      <div class="grid-services" style="margin-top: 1.5rem">
        <article class="card">
          <h3>Three trucks on the line</h3>
          <p>Every part is paint + type. The bag only drops pieces that still have an open socket across the three chassis — no dead third wheels.</p>
        </article>
        <article class="card">
          <h3>Snap, don’t slot</h3>
          <p>Spatial assembly on real silhouettes: cab, structural battery pack, wheels, canopy, bumper. Guides teach each new part once, then drop off.</p>
        </article>
        <article class="card">
          <h3>Play in the browser</h3>
          <p>
            No install. Hosted at <a href="/cybertruck-tetris/">/cybertruck-tetris/</a>. Build notes:
            <a href="/blog/cybertruck-assembly-line-live/">read the post →</a>
          </p>
        </article>
      </div>
      <p style="margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: 1rem">
        <a href="/cybertruck-tetris/" class="btn btn--live">Play the game</a>
        <a href="/blog/cybertruck-assembly-line-live/" class="btn btn--ghost">Read the post</a>
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow">Build log</p>
      <h2>Latest from the blog</h2>
      {
        posts.length > 0 ? (
          <ul class="blog-list">
            {posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                    timeZone: "UTC",
                  })}
                </time>
              </li>
            ))}
          </ul>
        ) : (
          <p class="lead">Posts will appear here once published.</p>
        )
      }
      <p style="margin-top: 1.5rem">
        <a href="/blog/">All posts →</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: 6rem 0 5rem;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    background: linear-gradient(
      135deg,
      rgba(139, 124, 248, 0.06) 0%,
      rgba(62, 224, 208, 0.03) 50%,
      transparent 100%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 42rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>