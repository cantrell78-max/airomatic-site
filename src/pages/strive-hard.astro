---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Strive Hard"
  description="Leisure Suit Larry for SF tech founders — a crude choose-your-own-adventure RPG. Blank X account, Tenderloin studio, yacht afterparties. Play free in the browser."
  ogImage="/images/blog/strive-hard-og.jpg"
  ogImageAlt="Strive Hard — a founder romance RPG on airomatic.ai"
>
  <section class="sh-page">
    <div class="sh-bar">
      <div class="container sh-bar__inner">
        <p class="sh-bar__text">
          <strong>Strive Hard</strong>
          <span class="sh-bar__sep">·</span>
          Leisure Suit Larry energy for the AI / social media era
        </p>
        <p class="sh-bar__links">
          <a href="/blog/strive-hard-live/">Build log</a>
          <span class="sh-bar__sep">·</span>
          <a href="/strive-hard/app.html" target="_blank" rel="noopener">Open fullscreen</a>
        </p>
      </div>
    </div>
    <iframe
      class="sh-frame"
      src="/strive-hard/app.html"
      title="Strive Hard — playable founder RPG"
      allow="fullscreen"
    ></iframe>
  </section>
</BaseLayout>

<style>
  .sh-page {
    display: flex;
    flex-direction: column;
    /* Site header is sticky; fill remaining viewport */
    min-height: calc(100vh - var(--header-h, 4rem));
    margin: 0;
    padding: 0;
  }

  .sh-bar {
    flex-shrink: 0;
    border-bottom: 1px solid var(--border);
    background: rgba(6, 7, 11, 0.92);
  }

  .sh-bar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    padding-top: 0.65rem;
    padding-bottom: 0.65rem;
  }

  .sh-bar__text {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .sh-bar__text strong {
    color: var(--text);
    font-weight: 600;
  }

  .sh-bar__sep {
    margin: 0 0.35rem;
    opacity: 0.5;
  }

  .sh-bar__links {
    margin: 0;
    font-size: 0.8rem;
  }

  .sh-bar__links a {
    color: var(--accent);
  }

  .sh-frame {
    flex: 1;
    width: 100%;
    min-height: min(720px, calc(100vh - var(--header-h, 4rem) - 3rem));
    border: 0;
    display: block;
    background: #0b0c10;
  }
</style>
