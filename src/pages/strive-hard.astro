---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Strive Hard"
  description="Leisure Suit Larry for SF tech founders — Chapter 2 The Round (Spaces, Thiel, data room, board), Mercury, Soft HQ, Dylan, Palantir, FlareUp. Play free in the browser."
  ogImage="/images/blog/strive-hard-og.jpg"
  ogImageAlt="Strive Hard — a founder romance RPG on airomatic.ai"
>
  <section class="sh-page">
    <iframe
      class="sh-frame"
      src="/strive-hard/app.html"
      title="Strive Hard — playable founder RPG"
      allow="fullscreen"
      allowfullscreen
    ></iframe>
  </section>
</BaseLayout>

<style>
  .sh-page {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - var(--header-h, 4rem));
    margin: 0;
    padding: 0;
  }

  .sh-frame {
    flex: 1;
    width: 100%;
    min-height: calc(100vh - var(--header-h, 4rem));
    border: 0;
    display: block;
    background: #0b0c10;
  }
</style>
